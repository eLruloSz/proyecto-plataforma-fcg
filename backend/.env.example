# Copia este archivo como .env

# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL=postgresql://becas:becas_dev_password@localhost:5432/becas
DATABASE_SSL=false

# --- Sesión ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES=8h

# --- Usuario inicial (solo si la base no tiene usuarios, ej. en producción) ---
# ADMIN_EMAIL=coordinacion@fundacion.cl
# ADMIN_PASSWORD=una-clave-larga
# ADMIN_NOMBRE=Coordinación de Selección

# --- Correo ---
# Desarrollo: Mailpit (docker compose up). Ver los correos en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fundación Carmen Goudie <becas@fundacion.local>
# Token del webhook del proveedor (entregado / rebotado):
#   https://tu-dominio/api/webhooks/correo?token=ESTE_VALOR
MAIL_WEBHOOK_TOKEN=cambia-este-token

# --- Servidor ---
PORT=3000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
