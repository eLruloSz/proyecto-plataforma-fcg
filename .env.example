# Copia este archivo como .env (queda fuera del repo) para probar con un correo real.
# Sin .env, los correos van a Mailpit (http://localhost:8025) y no salen a internet.
#
# Ejemplo con Gmail: necesitas una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Con Gmail el remitente debe ser la misma cuenta.
MAIL_FROM=Fundación Carmen Goudie <tu.correo@gmail.com>

# IMPORTANTE en pruebas: todos los correos llegan a esta casilla (no a los liceos
# ni a los estudiantes), con el destinatario real en el asunto. Déjalo vacío SOLO en producción.
MAIL_REDIRIGIR_A=tu.correo@gmail.com
